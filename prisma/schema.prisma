generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  whatsapp     String?
  createdAt    DateTime @default(now())
}

model Tour {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  category    String
  shortDesc   String
  description String
  highlights  String
  duration    String
  distance    String?
  priceFrom   Float?
  showPrice   Boolean     @default(true)
  included    String
  excluded    String
  mapPoints   String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
  photos      TourPhoto[]
}

model TourPhoto {
  id        String  @id @default(cuid())
  tourId    String
  url       String
  caption   String?
  sortOrder Int     @default(0)
  type      String  @default("GALLERY")
  tour      Tour    @relation(fields: [tourId], references: [id])
}

model Transfer {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  fromArea    String
  toArea      String
  description String?
  priceFrom   Float?
  showPrice   Boolean   @default(true)
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  bookings    Booking[]
}

model Booking {
  id              String       @id @default(cuid())
  clientName      String
  clientEmail     String
  clientPhone     String
  serviceType     String
  tourId          String?
  transferId      String?
  passengers      String
  notes           String?
  referralSource  String?
  status          String       @default("NEW")
  adminNotes      String?
  reviewToken     String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  date            String
  dropoffLocation String?
  pickupLocation  String?
  arrivalTime     String?
  arrivalType     String?
  flightNumber    String?
  portGate        String?
  portName        String?
  tour            Tour?        @relation(fields: [tourId], references: [id])
  transfer        Transfer?    @relation(fields: [transferId], references: [id])
  logs            BookingLog[]
}

model CalendarDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  status    String   @default("AVAILABLE")
  bookingId String?
  note      String?
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  category    String?
  isPublic    Boolean        @default(true)
  isTrip      Boolean        @default(false)
  shareToken  String?        @unique
  clientName  String?
  bookingId   String?
  createdAt   DateTime       @default(now())
  tourId      String?
  transferId  String?
  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id        String       @id @default(cuid())
  albumId   String
  url       String
  thumbnail String?
  caption   String?
  sortOrder Int          @default(0)
  album     GalleryAlbum @relation(fields: [albumId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String?
  clientName String
  tourTitle  String
  rating     Int
  text       String
  isApproved Boolean  @default(false)
  isFeatured Boolean  @default(false)
  token      String   @unique
  createdAt  DateTime @default(now())
}

model HomepagePhoto {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model GlobalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BookingLog {
  id        String   @id @default(cuid())
  bookingId String
  action    String
  message   String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  name      String
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
